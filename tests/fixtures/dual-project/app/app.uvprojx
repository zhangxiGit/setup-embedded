<?xml version="1.0" encoding="UTF-8"?>
<Project>
  <Targets>
    <Target>
      <TargetName>Application</TargetName>
      <TargetOption>
        <TargetCommonOption>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>app</OutputName>
          <CreateHexFile>1</CreateHexFile>
        </TargetCommonOption>
        <TargetArmAds>
          <LDads>
            <IROM>
              <StartAddress>0x08004000</StartAddress>
              <Size>0x0003C000</Size>
            </IROM>
            <ScatterFile>.\app.sct</ScatterFile>
          </LDads>
        </TargetArmAds>
      </TargetOption>
    </Target>
  </Targets>
</Project>
